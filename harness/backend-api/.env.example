# Copy to .env (never committed). Values below work with ./compose.yaml.
SPRING_PROFILES_ACTIVE=local

# Application connection (pooled endpoint in the demo environment)
DATABASE_URL=jdbc:postgresql://localhost:5432/quita
DATABASE_USERNAME=quita
DATABASE_PASSWORD=quita

# Flyway connection (direct endpoint in the demo environment)
DATABASE_MIGRATION_URL=jdbc:postgresql://localhost:5432/quita

# Token signing (at least 32 random bytes; generate with: openssl rand -base64 48)
JWT_SECRET=change-me

# Webhook signature shared with the payment gateway
GATEWAY_WEBHOOK_SECRET=change-me

# Public address of this API, used by the fake gateway to call the webhook
API_PUBLIC_URL=http://localhost:8080

# Local profile only
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:3000
